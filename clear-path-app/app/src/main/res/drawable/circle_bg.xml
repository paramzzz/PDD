<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#DDF4F8"/>
        </shape>
    </item>

    <!-- Middle Circle -->
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">

        <shape android:shape="oval">
            <solid android:color="#C8ECF4"/>
        </shape>
    </item>

    <!-- Inner Circle -->
    <item
        android:left="24dp"
        android:top="24dp"
        android:right="24dp"
        android:bottom="24dp">

        <shape android:shape="oval">
            <solid android:color="#B5E4EE"/>
        </shape>
    </item>

</layer-list>