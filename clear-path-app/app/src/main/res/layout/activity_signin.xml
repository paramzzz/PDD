<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/logo"
            android:layout_gravity="center"
            android:background="@drawable/logo_bg"
            android:padding="20dp"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doctor Registration"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0B4E75"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"/>

        <!-- Name -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Doctor Name"
            android:background="@drawable/edit_bg"
            android:padding="16dp"
            android:layout_marginTop="30dp"/>

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Email"
            android:background="@drawable/edit_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:inputType="textEmailAddress"/>

        <!-- Phone -->
        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Phone"
            android:background="@drawable/edit_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:inputType="phone"/>

        <!-- Clinic -->
        <EditText
            android:id="@+id/etClinic"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Clinic Name"
            android:background="@drawable/edit_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp"/>

        <!-- License -->
        <EditText
            android:id="@+id/etLicense"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Doctor License ID"
            android:background="@drawable/edit_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp"/>

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Password"
            android:background="@drawable/edit_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:inputType="textPassword"/>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Create Account"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:backgroundTint="#1099BC"
            android:layout_marginTop="30dp"/>

    </LinearLayout>

</ScrollView>