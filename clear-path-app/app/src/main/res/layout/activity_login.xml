<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/logo"
            android:background="@drawable/logo_bg"
            android:padding="20dp" />

        <!-- Live Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Live"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:background="#E8F5E9"
            android:padding="6dp"
            android:layout_marginTop="-10dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ClearPath"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#0B4E75"
            android:layout_marginTop="20dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The Speed of Care."
            android:textSize="18sp"
            android:textColor="#7AA6B3"
            android:layout_marginTop="10dp"
            android:gravity="center" />

        <!-- Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:layout_marginTop="40dp"
            android:elevation="4dp">

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor Sign-In"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#0B4E75" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure access to hospital AI workflows"
                android:textSize="16sp"
                android:textColor="#7AA6B3"
                android:layout_marginTop="10dp" />

            <!-- Email -->
            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="doctor@clearpath.ai"
                android:background="@drawable/edit_bg"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:inputType="textEmailAddress" />

            <!-- Password -->
            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Enter password"
                android:background="@drawable/edit_bg"
                android:padding="16dp"
                android:layout_marginTop="20dp"
                android:inputType="textPassword" />

            <!-- Login Button -->
            <Button
                android:id="@+id/loginBtn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Sign In to Dashboard"
                android:textAllCaps="false"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1099BC"
                android:layout_marginTop="30dp" />

            <!-- Demo Text -->
            <!-- Register Text -->
            <TextView
                android:id="@+id/txtRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New to ClearPath? Click here"
                android:textColor="#1099BC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>