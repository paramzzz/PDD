<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvBundleAvatar"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="#E8F6F8"
        android:textColor="#0F98B8"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:text="P"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvBundlePatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Name"
            android:textColor="#37474F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBundlePatientMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00y · M · Chief Complaint text snippet placeholder layout"
            android:textColor="#78909C"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="〉"
        android:textColor="#B0BEC5"
        android:textSize="16sp"
        android:textStyle="bold"/>
</LinearLayout>