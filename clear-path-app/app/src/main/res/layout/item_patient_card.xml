<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_margin="6dp">

    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="P"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:background="#FFE5E5"
        android:textColor="#E57373" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvPatientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Name"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#37474F" />
            <TextView
                android:id="@+id/tvRiskTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="STAT 9.5"
                android:textColor="#F44336"
                android:background="#FFE5E5"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvPatientMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00y · M · 0m ago"
            android:textColor="#78909C"
            android:textSize="13sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvComplaintSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chief complaint reason details entry..."
            android:textColor="#455A64"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/tvBpValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BP --/--"
                android:textColor="#78909C"
                android:background="#F0F4F8"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tvSpo2Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpO₂ --%"
                android:textColor="#F44336"
                android:background="#FFE5E5"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>