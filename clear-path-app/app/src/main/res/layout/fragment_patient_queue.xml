<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F98B8"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Queue"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvQueueSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 active · sorted by risk score"
            android:textColor="#DFF7FB"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="#0F98B8">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All 4"
                android:textColor="#FFFFFF"
                android:background="@drawable/chip_active_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                 />

            <TextView
                android:id="@+id/chipStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STAT 1"
                android:textColor="#DFF7FB"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                />

            <TextView
                android:id="@+id/chipHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High 1"
                android:textColor="#DFF7FB"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                />

            <TextView
                android:id="@+id/chipMed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Med 1"
                android:textColor="#DFF7FB"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                 />

            <TextView
                android:id="@+id/chipLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Low 1"
                android:textColor="#DFF7FB"
                android:background="@drawable/chip_inactive_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPatientQueue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false"/>

</LinearLayout>