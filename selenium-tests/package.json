{
  "name": "clear-path-selenium-tests",
  "version": "1.0.0",
  "description": "Enterprise Selenium E2E Testing Framework for CLEAR PATH Multi-Document Clinical Intelligence System",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/*.test.js --timeout 120000 --reporter mochawesome --reporter-options reportDir=reports/html,reportFilename=mochawesome",
    "report": "node utils/generateReports.js",
    "excel": "node utils/excelReporter.js",
    "all": "mocha tests/*.test.js --timeout 120000 && node utils/excelReporter.js"
  },
  "keywords": [
    "selenium",
    "e2e",
    "testing",
    "clearpath",
    "clinical-intelligence"
  ],
  "author": "ClearPath Enterprise QA Team",
  "license": "ISC",
  "dependencies": {
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.20.0",
    "xlsx": "^0.18.5"
  }
}
